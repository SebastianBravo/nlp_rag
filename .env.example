MILVUS_URI=http://milvus:19530
# Nombre = encoder + chunking. Si cambia alguno (o los prefijos/normalización), usar otra colección.
MILVUS_COLLECTION=rag_e5small_char1000_v1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Prefijos E5. Las comillas conservan el espacio final (sin ellas Compose lo recorta).
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_NORMALIZE=true
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:1.5b
MAX_CONTEXT_CHARS=8500
