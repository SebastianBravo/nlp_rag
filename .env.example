MILVUS_URI=http://milvus:19530
# Nombre = encoder + segmentación + alcance + versión. Si cambia alguno (o los prefijos/normalización), usar otra colección.
MILVUS_COLLECTION=rag_granite97m_sent256_s10k_v1
# Amplitud de búsqueda del índice HNSW, calibrada en reports/milvus/.
MILVUS_SEARCH_EF=64
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_REVISION=835ad14087e140460703cf0fae09f97d469d65c2
# granite no usa prefijos ni instrucciones (las comillas dejan explícito el valor vacío).
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_PASSAGE_PREFIX=""
EMBEDDING_NORMALIZE=true
OLLAMA_URL=http://ollama:11434
# Modelo por defecto de la API y la interfaz (cada petición puede elegir otro).
LLM_MODEL=qwen2.5:1.5b
# Ventana fija para todos los modelos (Ollama recorta en silencio lo que no cabe) y máximo de tokens de respuesta.
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
# Tokens del LLM por cada token del encoder: mayor cociente medido en los 4 LLM (1,237) + 5 %, en reports/rag/.
LLM_TOKEN_FACTOR=1.3
LLM_SEED=42
LLM_TIMEOUT=240
# Hilos de Ollama por petición: deja núcleos libres para etcd y Milvus (con los 10 ocupados, Milvus perdió su sesión).
LLM_NUM_THREAD=8
# Prompt versionado en prompts/<id>.yaml.
PROMPT_ID=rag_v1
# Registro JSONL de cada consulta (no se versiona: puede contener texto del corpus).
LOG_DIR=data/logs
